		summarizeBy: none
		sourceColumn: purchase_date

		variation Variation
			isDefault
			relationship: 91da4f81-e355-424d-ae38-1f0856ed43a2
			defaultHierarchy: LocalDateTable_2bb53ee8-38af-458a-8fca-c123e3a8342d.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column payment_value
