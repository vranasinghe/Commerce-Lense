		summarizeBy: none
		sourceColumn: order_status

	partition dm_customer_insights = m
		mode: import
		source =
				let
				    Source = Sql.Database(".", "olist_dw"),
				    dbo_dm_customer_insights = Source{[Schema="dbo",Item="dm_customer_insights"]}[Data]
				in
				    dbo_dm_customer_insights

	annotation PBI_ResultType = Table

