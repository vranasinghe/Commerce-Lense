table dm_customer_insights
	lineageTag: cd4ca0ee-05fd-4e59-81d8-b63b79cb6d06

	measure 'Total Orders' = DISTINCTCOUNT('dm_customer_insights'[order_id])
		formatString: #,0
		displayFolder: CommerceLens

	measure 'Orders With Items' = DISTINCTCOUNT('dm_sales_performance'[order_id])
		formatString: #,0
		displayFolder: CommerceLens

	measure 'Total Customers' = DISTINCTCOUNT('dm_customer_insights'[customer_unique_id])
		formatString: #,0
		displayFolder: CommerceLens

	measure 'Merchandise Value BRL' = SUM('dm_sales_performance'[price])
		formatString: "R$" #,0.00
		displayFolder: CommerceLens

	measure 'Total Freight BRL' = SUM('dm_sales_performance'[freight_value])
		formatString: "R$" #,0.00
		displayFolder: CommerceLens

	measure 'Gross Order Value BRL' = [Merchandise Value BRL] + [Total Freight BRL]
		formatString: "R$" #,0.00
		displayFolder: CommerceLens

	measure 'Total Payments BRL' = SUM('dm_customer_insights'[payment_value])
		formatString: "R$" #,0.00
		displayFolder: CommerceLens

	measure 'Average Order Value BRL' = DIVIDE([Merchandise Value BRL], [Total Orders])
		formatString: "R$" #,0.00
		displayFolder: CommerceLens

	measure 'Average Customer Rating' = AVERAGE('dm_customer_insights'[review_score])
		formatString: 0.00
		displayFolder: CommerceLens

	measure 'Reviewed Orders' = COUNT('dm_customer_insights'[review_score])
		formatString: #,0
		displayFolder: CommerceLens

	measure 'Satisfied Orders' = CALCULATE([Reviewed Orders], KEEPFILTERS('dm_customer_insights'[review_score] >= 4))
		formatString: #,0
		displayFolder: CommerceLens

	measure 'Customer Satisfaction %' = DIVIDE([Satisfied Orders], [Reviewed Orders])
		formatString: 0.0%
		displayFolder: CommerceLens

	measure 'Merchandise MoM %' = VAR PreviousValue = CALCULATE([Merchandise Value BRL], DATEADD('dim_date'[full_date], -1, MONTH)) RETURN IF(PreviousValue > 0, DIVIDE([Merchandise Value BRL] - PreviousValue, PreviousValue))
		formatString: 0.0%
		displayFolder: CommerceLens

	measure 'Merchandise YoY %' = VAR PreviousValue = CALCULATE([Merchandise Value BRL], DATEADD('dim_date'[full_date], -1, YEAR)) RETURN IF(PreviousValue > 0, DIVIDE([Merchandise Value BRL] - PreviousValue, PreviousValue))
		formatString: 0.0%
		displayFolder: CommerceLens

	measure 'Repeat Customers' = COUNTROWS(FILTER(VALUES('dm_customer_insights'[customer_unique_id]), CALCULATE(DISTINCTCOUNT('dm_customer_insights'[order_id])) > 1))
		formatString: #,0
		displayFolder: CommerceLens

	measure 'Delivered Merchandise BRL' = CALCULATE([Merchandise Value BRL], KEEPFILTERS('dm_customer_insights'[order_status] = "delivered"))
		formatString: "R$" #,0.00
		displayFolder: CommerceLens

