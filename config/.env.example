# Export these variables in your shell; no automatic dotenv loading.
# Defaults resolve against this repository, regardless of working directory.
# OLIST_RAW_DIR=C:\OlistDW\raw_data
# OLIST_LANDING_DIR=C:\OlistDW\landing
# OLIST_REPORT_DIR=C:\OlistDW\reports
OLIST_SQL_SERVER=.
OLIST_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Optional complete ODBC override; database must match chosen target.
# OLIST_ODBC_CONNECTION=DRIVER={ODBC Driver 17 for SQL Server};SERVER=.;DATABASE=olist_dw;Trusted_Connection=yes;
